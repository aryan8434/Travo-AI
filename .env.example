# Core
PORT=5000
HOST=127.0.0.1
NODE_ENV=development
# Generate a unique random secret of at least 32 characters.
JWT_SECRET=
MONGO_URI=mongodb://127.0.0.1:27017/travoai
# Exact reverse-proxy IP/subnet only. Empty means no trusted proxy.
TRUST_PROXY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000

# Optional chat providers: offline intent parsing works without keys.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Tried in order when the primary model is rate-limited or unavailable (each has its own quota).
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional semantic embeddings. Use local to avoid all embedding network calls.
EMBEDDING_PROVIDER=auto
GEMINI_EMBED_MODEL=gemini-embedding-001
# Optional separate index path; default is ./vectra_index
RAG_INDEX_DIR=
# Vercel serves the index built by scripts/buildVercel.mjs without disk writes.
RAG_READ_ONLY=0

# live (default): fresh rzp_live_ keys plus a webhook secret; the known Git-exposed key is rejected.
# test: rzp_test_ keys only, no real money moves; the webhook secret is optional. For demos.
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: confirm every booking for at most this many rupees (1 = a ₹1 charge).
# The booking and receipt keep the full value and show the uncollected balance.
BOOKING_CHARGE_INR=
# Separate random 32+ character secret configured on Razorpay's webhook endpoint.
RAZORPAY_WEBHOOK_SECRET=

# Admin operations are disabled unless a unique secret is configured (32+ recommended).
ADMIN_KEY=
WEATHER_API_KEY=
