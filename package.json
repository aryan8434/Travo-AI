{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon --ignore vectra_index/ --ignore data/ index.js",
    "generate:packages": "node scripts/generatePackages.mjs",
    "reindex": "node scripts/reindex.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "ingest:guide": "node scripts/ingestGuide.mjs",
    "validate:packages": "node scripts/validatePackages.mjs",
    "build": "npm --prefix frontend run build",
    "lint": "eslint frontend/src",
    "content:jobs": "node scripts/contentJobs.mjs",
    "check:production": "node scripts/checkProduction.mjs"
  },
  "keywords": [],
  "author": "Aryan",
  "license": "ISC",
  "description": "Backend for TravoAI travel booking assistant",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "groq-sdk": "^0.37.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.5",
    "pdfkit": "^0.20.2",
    "razorpay": "^2.9.8",
    "vectra": "^0.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "vectra": {
      "uuid": "11.1.1"
    }
  }
}
